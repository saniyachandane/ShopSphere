# Defaults use SQLite and work without this file.
DJANGO_SECRET_KEY=replace-this-before-deployment
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional MySQL configuration: set DB_ENGINE=mysql
DB_ENGINE=mysql
DB_NAME=shopsphere_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
